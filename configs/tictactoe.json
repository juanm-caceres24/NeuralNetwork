    "batch_size": 32,
    "learning_rate": 0.001,
    "shuffle": true,
    "num_threads": 4,
    "seed": 42,
    "validation_split": 0.0,
    "validation_shuffle": true,
    "keep_best_validation_model": false,
    "log_every_epochs": 25
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "num_workers": 4
  }
