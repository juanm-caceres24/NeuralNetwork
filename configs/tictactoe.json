{
  "model": {
    "layers": [
      { "size": 9 },
      { "size": 128, "activation": "relu" },
      { "size": 128, "activation": "relu" },
      { "size": 41, "activation": "softmax" }
    ],
    "init_seed": 42,
    "load_path": "",
    "save_path": "models/tictactoe_model.json",
    "save_on_finish": true
  },
  "training": {
    "dataset_path": "data/tictactoe_dataset.csv",
    "dataset_has_header": false,
    "loss": "cce",
    "optimizer": "adam",
