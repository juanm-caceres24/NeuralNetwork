{
  "model": {
    "layers": [
      {
        "size": 264
      },
      {
        "size": 64,
        "activation": "leaky_relu"
      },
      {
        "size": 32,
        "activation": "leaky_relu"
      },
      {
        "size": 3,
        "activation": "softmax"
      }
    ],
    "init_seed": 42,
    "load_path": "",
    "save_path": "models/btc_4h_signal.json",
    "save_on_finish": true
  },
  "training": {
    "dataset_path": "data/btc_4h_signal_24to6.csv",
    "dataset_has_header": true,
    "dataset_generator": "",
    "loss": "cce",
    "huber_delta": 1.0,
    "optimizer": "adam",
    "epochs": 300,
    "batch_size": 64,
    "learning_rate": 0.001,
    "lr_schedule": "cosine",
    "min_learning_rate": 0.0001,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-08,
    "weight_decay": 0.0015,
    "dropout_rate": 0.2,
    "grad_clip_norm": 1.0,
    "shuffle": true,
    "num_threads": 4,
    "seed": 100,
    "validation_split": 0.2,
    "validation_shuffle": false,
    "keep_best_validation_model": true,
    "early_stopping_patience": 25,
    "early_stopping_min_delta": 0.0001,
    "report_path": "reports/btc_4h_signal_report.json",
    "log_every_epochs": 10
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8083,
    "num_workers": 4
  }
}
